FROM node:22.14-alpine AS builder
RUN corepack enable
WORKDIR /workspace
ARG VITE_RULETWIN_AUTH_MODE=development
ARG VITE_RULETWIN_OIDC_AUTHORITY
ARG VITE_RULETWIN_OIDC_AUDIENCE
ARG VITE_RULETWIN_OIDC_CLIENT_ID
ARG VITE_RULETWIN_OIDC_REDIRECT_URI
ARG VITE_RULETWIN_OIDC_POST_LOGOUT_REDIRECT_URI
ENV VITE_RULETWIN_AUTH_MODE=$VITE_RULETWIN_AUTH_MODE \
    VITE_RULETWIN_OIDC_AUTHORITY=$VITE_RULETWIN_OIDC_AUTHORITY \
    VITE_RULETWIN_OIDC_AUDIENCE=$VITE_RULETWIN_OIDC_AUDIENCE \
    VITE_RULETWIN_OIDC_CLIENT_ID=$VITE_RULETWIN_OIDC_CLIENT_ID \
    VITE_RULETWIN_OIDC_REDIRECT_URI=$VITE_RULETWIN_OIDC_REDIRECT_URI \
    VITE_RULETWIN_OIDC_POST_LOGOUT_REDIRECT_URI=$VITE_RULETWIN_OIDC_POST_LOGOUT_REDIRECT_URI
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web ./apps/web
RUN pnpm --filter @ruletwin/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
