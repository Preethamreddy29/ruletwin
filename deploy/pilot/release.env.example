# Public deployment configuration only. Copy outside Git and provide real values there.
RULETWIN_RELEASE_VERSION=0.4.0-pilot.1
RULETWIN_HOSTNAME=pilot.example.invalid
RULETWIN_HTTPS_PORT=8443
RULETWIN_BASE_URL=https://pilot.example.invalid:8443

# Every deployable image must be immutable and include an sha256 digest.
RULETWIN_API_IMAGE=ghcr.io/example/ruletwin-api@sha256:REPLACE_WITH_64_HEX_CHARACTERS
RULETWIN_WEB_IMAGE=ghcr.io/example/ruletwin-web@sha256:REPLACE_WITH_64_HEX_CHARACTERS
RULETWIN_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_64_HEX_CHARACTERS
RULETWIN_PROMETHEUS_IMAGE=prom/prometheus@sha256:REPLACE_WITH_64_HEX_CHARACTERS
RULETWIN_GATEWAY_IMAGE=caddy@sha256:REPLACE_WITH_64_HEX_CHARACTERS

RULETWIN_OIDC_ISSUER=https://identity.example.invalid/
RULETWIN_OIDC_AUDIENCE=https://api.example.invalid/ruletwin
RULETWIN_OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
RULETWIN_OIDC_TENANT_CLAIM=https://example.invalid/tenant_id

# These paths point to provider-mounted or host-protected files outside Git.
RULETWIN_POSTGRES_ADMIN_PASSWORD_SECRET_FILE=C:/secure/ruletwin/postgres-admin-password
RULETWIN_POSTGRES_APP_PASSWORD_SECRET_FILE=C:/secure/ruletwin/postgres-app-password
RULETWIN_ADMIN_DATABASE_URL_SECRET_FILE=C:/secure/ruletwin/admin-database-url
RULETWIN_APP_DATABASE_URL_SECRET_FILE=C:/secure/ruletwin/app-database-url
RULETWIN_TLS_CERT_FILE=C:/secure/ruletwin/tls.crt
RULETWIN_TLS_KEY_FILE=C:/secure/ruletwin/tls.key
