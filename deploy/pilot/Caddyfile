{
	admin off
	auto_https off
}

:8443 {
	tls /run/tls/tls.crt /run/tls/tls.key
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:"
		-Server
	}

	# Prometheus scrapes the API directly on the internal frontend network.
	# Development and framework introspection surfaces are never edge routes.
	@internalOnly path /api/metrics /api/openapi.json /api/docs* /api/v1/dev/*
	respond @internalOnly 404

	reverse_proxy web:8080
}
